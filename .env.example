# ─── Service ─────────────────────────────────────────────
# По умолчанию service_version Settings берёт из pyproject.toml. Раскомментируйте,
# если нужен hotfix-тег образа, отличный от версии пакета.
# SERVICE_VERSION=0.4.0
MODEL_VERSION=ru-detector-0.1.0
# В проде ставим true — lifespan падает с RuntimeError, если JWT_SECRET остался дефолтным.
IS_PRODUCTION=false
# tfidf | transformer | cascade (по умолчанию в коде — tfidf; каскад — если нужен гибрид с трансформером)
DETECTOR_TYPE=tfidf
CASCADE_LO=0.30
CASCADE_HI=0.70

# ─── Risk thresholds ─────────────────────────────────────
MIN_CHARS=300
MAX_CHARS=8000
RISK_THRESH_LOW=0.30
RISK_THRESH_HIGH=0.70
VERDICT_THRESHOLD=0.50

# Таймаут инференса (мс). Допустимо и CASCADE_TIMEOUT_MS (каноническое имя поля в Settings).
REQUEST_TIMEOUT_MS=3000

# ─── Calibration ─────────────────────────────────────────
CALIBRATION_ENABLED=true

# ─── Observability ───────────────────────────────────────
LOG_LEVEL=INFO
# LOG_TEXT=true сохраняет сырой текст в логи (privacy risk!) — оставляйте false в проде
LOG_TEXT=false

# ─── Database ────────────────────────────────────────────
# В YC: postgresql+asyncpg://<user>:<password>@<host>:6432/<db>?ssl=verify-full
DATABASE_URL=postgresql+asyncpg://aitrust:aitrust@localhost:5432/aitrust
DB_POOL_SIZE=5
DB_POOL_OVERFLOW=5
# Куда писать analyses, если БД упала. В контейнере — внутрь /app/logs/, в проде — на mounted volume.
DB_FALLBACK_LOG_PATH=/app/logs/db_fallback.jsonl

# ─── Cache ───────────────────────────────────────────────
CACHE_MAXSIZE=1024

# ─── Disclaimer ──────────────────────────────────────────
# Опционально — переопределяет дефолтный текст в schemas.DEFAULT_DISCLAIMER.
# Полезно для разных каналов (PWA / Telegram / API): можно подставить более короткую версию для бота.
# DISCLAIMER_TEXT="Результат вероятностный, не доказательство. Решения с правовыми последствиями — за человеком."

# ─── LLM-ключи для сбора датасета ────────────────────────
# Runtime их не использует. Если запускаете `scripts/data_collection/*`,
# смотрите `scripts/data_collection/.env.example`.
