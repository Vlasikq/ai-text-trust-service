# ─── Service ─────────────────────────────────────────────
SERVICE_VERSION=0.1.0
MODEL_VERSION=ru-detector-0.1.0

MIN_CHARS=300
MAX_CHARS=8000

RISK_THRESH_LOW=0.30
RISK_THRESH_HIGH=0.70

REQUEST_TIMEOUT_MS=3000

# ─── OpenAI (GPT-4o, GPT-4o-mini) ───────────────────────
OPENAI_API_KEY=sk-...

# ─── GigaChat (Сбер) ─────────────────────────────────────
# Получить: https://developers.sber.ru/studio
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=false

# ─── YandexGPT ───────────────────────────────────────────
# Получить: https://console.cloud.yandex.ru
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Альтернативно: YANDEX_IAM_TOKEN=

# ─── Groq ────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Gemini (Google) ─────────────────────────────────────
GEMINI_API_KEY=
