# Ключи LLM-API для скриптов сбора датасета (`scripts/data_collection/*`).
# Runtime сервиса (api/worker) эти переменные не использует — здесь они лежат,
# чтобы исследовательские скрипты могли подсосать ключи без правки кода.

# ─── OpenAI (GPT-4o, GPT-4o-mini) ───────────────────────
OPENAI_API_KEY=sk-...

# ─── GigaChat (Сбер) ─────────────────────────────────────
# Получить: https://developers.sber.ru/studio
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL_CERTS=false

# ─── YandexGPT ───────────────────────────────────────────
# Получить: https://console.cloud.yandex.ru
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Альтернативно: YANDEX_IAM_TOKEN=

# ─── Groq ────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Gemini (Google) ─────────────────────────────────────
GEMINI_API_KEY=
