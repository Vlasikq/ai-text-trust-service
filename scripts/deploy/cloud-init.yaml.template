#cloud-config
# Рендерится через scripts/deploy/render_cloud_init.py.

# Debug SSH-доступ к VM. Публичные ключи подставляются render_cloud_init.py
# из scripts/deploy/.local/ssh_authorized_keys. 
# В YC активирован OS Login, поэтому даже без этих ключей доступ к VM остаётся через Serial Console.
users:
  - default
  - name: ubuntu
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    ssh_authorized_keys:
__SSH_AUTHORIZED_KEYS__

package_update: true
package_upgrade: false
packages:
  - docker.io
  - docker-compose-v2
  - ca-certificates
  - curl
  - jq
  - postgresql-client

write_files:
  - path: /opt/aitrust/Caddyfile
    permissions: '0644'
    content: |
__CADDYFILE_CONTENT__

  - path: /opt/aitrust/docker-compose.yml
    permissions: '0644'
    content: |
__COMPOSE_CONTENT__

  - path: /opt/aitrust/bootstrap.sh
    permissions: '0755'
    content: |
__BOOTSTRAP_CONTENT__

runcmd:
  - bash /opt/aitrust/bootstrap.sh
